{
  "format": "pyWellSFM.DESimulationSchema",
  "version": "1.0",
  "depositionalEnvironmentModel": {
    "format": "pyWellSFM.DepositionalEnvironmentModelSchema",
    "version": "1.0",
    "name": "DESimModel",
    "environments": [
      {
        "name": "shallow",
        "waterDepthModel": {
          "format": "pyWellSFM.EnvironmentConditionModelData",
          "version": "1.0",
          "model": {
            "modelType": "Uniform",
            "minValue": 0.0,
            "maxValue": 20.0
          }
        }
      }
    ]
  },
  "weights": {
    "shallow": 1.0
  },
  "params": {
    "waterDepth_sigma": 8.0,
    "transition_sigma": 10.0,
    "trend_sigma": 0.5,
    "trend_window": 4,
    "interval_distance_method": "center"
  }
}
